<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DoctorDashboardController">

   <!-- Sidebar -->
   <left>
      <fx:include fx:id="sidebar" source="DoctorSidebarView.fxml" />
   </left>

   <center>
      <VBox alignment="TOP_CENTER" prefHeight="584.0" prefWidth="660.0" spacing="15" BorderPane.alignment="CENTER">
         <Label prefHeight="70.0" text="My Dashboard" textFill="#38989c">
            <font>
               <Font name="Arial Bold" size="40.0" />
            </font>
         </Label>
         <VBox alignment="CENTER" spacing="20.0" VBox.vgrow="ALWAYS">
            <padding>
               <Insets bottom="10.0" left="15.0" right="15.0" top="5.0" />
            </padding>

            <!-- (Log Glycemia, Therapy, My chart) -->
            <HBox alignment="CENTER" spacing="25.0">

               <StackPane onMouseClicked="#handleMyPatient" prefHeight="180.0" prefWidth="200.0" style="-fx-border-radius: 0 30 0 0; -fx-border-color: #F1F2F7; -fx-background-color: white;">
                  <effect><DropShadow color="#9a9696" /></effect>
                  <VBox alignment="CENTER" onMouseClicked="#handleMyPatient" spacing="12" styleClass="container" stylesheets="@../style/styles.css">
                     <ImageView fitHeight="165.0" fitWidth="151.0" onMouseClicked="#handleMyPatient" preserveRatio="true">
                        <Image url="@../img/my_pat_noBg.png" />
                     </ImageView>
                     <Button mnemonicParsing="false" onAction="#handleMyPatient" styleClass="myButtons" stylesheets="@../style/styles.css" text="My Patients" />
                  </VBox>
               </StackPane>

               <StackPane onMouseClicked="#handleOtherPatient" prefHeight="180.0" prefWidth="200.0" style="-fx-border-radius: 0 30 0 0; -fx-border-color: #F1F2F7; -fx-background-color: white;">
                  <effect><DropShadow color="#9a9696" /></effect>
                  <VBox alignment="CENTER" onMouseClicked="#handleOtherPatient" spacing="12" styleClass="container" stylesheets="@../style/styles.css">
                     <ImageView fitHeight="110.0" fitWidth="129.0" onMouseClicked="#handleOtherPatient" preserveRatio="true">
                        <Image url="@../img/other_pat_noBg.png" />
                     </ImageView>
                     <Button mnemonicParsing="false" onAction="#handleOtherPatient" styleClass="myButtons" stylesheets="@../style/styles.css" text="All Patients" />
                  </VBox>
               </StackPane>
            </HBox>

            <!-- (Messages, Contacts) -->
            <HBox alignment="CENTER" spacing="25.0">
               <StackPane prefHeight="180.0" prefWidth="200.0" style="-fx-border-radius: 0 30 0 0; -fx-border-color: #F1F2F7; -fx-background-color: white;">
                  <effect><DropShadow color="#9a9696" /></effect>
                  <VBox alignment="CENTER" onMouseClicked="#handleNotification" spacing="12" styleClass="container" stylesheets="@../style/styles.css">
                     <ImageView fitHeight="85.0" fitWidth="85.0" onMouseClicked="#handleNotification" preserveRatio="true">
                        <Image url="@../img/notification_noBg.png" />
                     </ImageView>
                     <Button mnemonicParsing="false" onAction="#handleNotification" styleClass="myButtons" stylesheets="@../style/styles.css" text="Messages" />
                  </VBox>
               </StackPane>
            </HBox>
         </VBox>
      </VBox>
   </center>
</BorderPane>
