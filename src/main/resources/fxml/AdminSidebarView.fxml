<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="610.0" prefWidth="240" styleClass="sidebar" stylesheets="@../style/styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AdminSidebarController">

    <!-- Logo -->
    <ImageView fitHeight="131.0" fitWidth="128.0" layoutX="45.0" layoutY="15.0" preserveRatio="true">
        <Image url="@../img/admin_noBg.png"/>
    </ImageView>
   <Label fx:id="welcomeLabel" layoutX="74.0" layoutY="159.0" prefHeight="17.0" prefWidth="74.0" textFill="WHITE">
      <font>
         <Font name="System Bold" size="14.0" />
      </font></Label>

    <Line endX="88.5" layoutX="120.0" layoutY="206.0" startX="-88.5" stroke="WHITE" />

    <!-- Buttons -->
    <HBox alignment="CENTER_LEFT" layoutX="30.0" layoutY="228.0" prefHeight="30" prefWidth="180">
        <ImageView fitHeight="35.0" fitWidth="30.0" preserveRatio="true">
            <Image url="@../img/profile_noBg.png"/>
        </ImageView>
        <Button onAction="#handleViewProfile" styleClass="myButtons" text="My Account" textFill="WHITE">
        <font>
            <Font name="System Bold" size="12.0"/>
        </font>
        </Button>
    </HBox>

    <HBox alignment="CENTER_LEFT" layoutX="30.0" layoutY="275.0" prefHeight="30" prefWidth="180">
        <ImageView fitHeight="29.0" fitWidth="30.0" preserveRatio="true">
            <Image url="@../img/pat_list_noBg.png"/>
        </ImageView>
        <Button onAction="#handlePatientList" styleClass="myButtons" text="Patients List" textFill="WHITE">
        <font>
            <Font name="System Bold" size="12.0"/>
        </font>
        </Button>
    </HBox>

    <HBox alignment="CENTER_LEFT" layoutX="30.0" layoutY="321.0" prefHeight="30" prefWidth="180">
        <ImageView fitHeight="33.0" fitWidth="30.0" preserveRatio="true">
            <Image url="@../img/doc_list_noBg.png"/>
        </ImageView>
        <Button onAction="#handleDoctorList" styleClass="myButtons" text="Doctors list" textFill="WHITE">
        <font>
            <Font name="System Bold" size="12.0"/>
        </font>
        </Button>
    </HBox>

    <!-- Logout -->
    <Button layoutX="52.0" layoutY="553.0" onAction="#handleLogout" prefHeight="30.0" prefWidth="110.0" styleClass="logout-button" text="Logout" />
    <ImageView fitHeight="30.0" fitWidth="30.0" layoutX="60.0" layoutY="553.0" pickOnBounds="true" preserveRatio="true">
        <Image url="@../img/logout_noBg.png"/>
    </ImageView>
    <HBox alignment="CENTER_LEFT" layoutX="30.0" layoutY="379.0" prefHeight="30" prefWidth="180">
        <ImageView fitHeight="34.0" fitWidth="27.0" preserveRatio="true">
            <Image url="@../img/doc_activity_noBg.png"/>
        </ImageView>
        <Button onAction="#handleDoctorActivityLog" styleClass="myButtons" text="Doctor's activity log"
                textFill="WHITE">
           <font>
               <Font name="System Bold" size="12.0"/>
           </font>
        </Button>
    </HBox>
    <HBox alignment="CENTER_LEFT" layoutX="30.0" layoutY="431.0" prefHeight="30" prefWidth="180">
        <ImageView fitHeight="28.0" fitWidth="30.0" preserveRatio="true">
            <Image url="@../img/dashboard_noBg.png"/>
        </ImageView>
        <Button onAction="#handleDashboard" styleClass="myButtons" text="Dashboard" textFill="WHITE">
           <font>
               <Font name="System Bold" size="12.0"/>
           </font>
        </Button>
    </HBox>
</AnchorPane>
