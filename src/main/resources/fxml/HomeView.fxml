<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fx:id="HomepageVBox" styleClass="homePage" stylesheets="@../style/styles.css"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.HomeController">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
   </padding>
   <ImageView fx:id="logoImageView" fitHeight="350.0" fitWidth="610.0" pickOnBounds="true" preserveRatio="true">
      <Image url="@../img/VelyaLife_home_noBg.png"/>
   </ImageView>
   <Label fx:id="textLabel" text="Your health, in your hands, every single day." wrapText="true">
      <font>
         <Font name="Arial Black" size="14.0"/>
      </font>
   </Label>
   <!-- Buttons -->
   <HBox alignment="CENTER" spacing="20.0">
      <Button id="login_btn" fx:id="loginButton" onAction="#handleLogin" prefHeight="40.0" prefWidth="126.0"
              styleClass="buttons" stylesheets="@../style/styles.css" text="Login"/>
   </HBox>
</VBox>
