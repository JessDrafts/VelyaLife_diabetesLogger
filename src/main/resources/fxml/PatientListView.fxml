<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PatientListController">

   <!-- Sidebar -->
   <left>
      <fx:include fx:id="sidebar" source="AdminSidebarView.fxml" />
   </left>

   <center>
      <VBox alignment="CENTER" spacing="15.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
         </padding>
         <Label text="Patients List">
            <font>
               <Font name="Arial Black" size="18.0"/>
            </font>
         </Label>
         <TableView fx:id="patientTable" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="nameColumn" prefWidth="120.0" text="Name"/>
               <TableColumn fx:id="lastNameColumn" prefWidth="120.0" text="Last name"/>
               <TableColumn fx:id="usernameColumn" prefWidth="120.0" text="Username"/>
               <TableColumn fx:id="emailColumn" prefWidth="180.0" text="Email"/>
               <TableColumn fx:id="actionColumn" prefWidth="100.0" text="Actions"/>
            </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
         </TableView>
         <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button fx:id="registerButton" mnemonicParsing="false" onAction="#handleSignup" styleClass="buttons"
                    text="Sign up User"/>
         </HBox>
      </VBox>
   </center>
</BorderPane>
